// Prisma schema — MySQL
// Run: npm run prisma:migrate -- --name init

generator client {
  // Production runs through Prisma Accelerate (DATABASE_URL=prisma://…), so the
  // client is generated with `--no-engine` (see build:api) and no local query
  // engine is bundled or run — this is what permanently fixes the Hostinger
  // CloudLinux "timer has gone away" crash. For local dev against a mysql:// URL,
  // run a plain `npx prisma generate` (which bundles the native engine).
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  // Runtime: DATABASE_URL is the Prisma Accelerate URL (prisma://…) so queries run
  // through Accelerate's cloud engine + pooler — no local query engine, which
  // permanently avoids the Hostinger "timer has gone away" crash.
  url       = env("DATABASE_URL")
  // Migrations need a direct connection (Accelerate can't run DDL): the real mysql:// URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

// How a vendor account came to exist: the partner registered themselves,
// or an admin created the account on their behalf.
enum VendorCreationSource {
  SELF_REGISTRATION
  ADMIN
}

enum SlotStatus {
  ACTIVE
  INACTIVE
}

enum SpaceApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum BookingType {
  HOURLY
  MONTHLY
}

// "List your space" prospect submissions from the customer site, reviewed by admin.
enum VendorLeadStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  PAID
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?
  phone         String?      @unique
  fullName      String
  role          Role         @default(CUSTOMER)
  status        UserStatus   @default(ACTIVE)
  emailVerified Boolean      @default(false)
  avatarUrl     String?
  provider      AuthProvider @default(EMAIL)
  providerId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vendor        Vendor?
  bookings      Booking[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  savedSpaces   SavedSpace[]
  vehicles      VehicleRegistration[]
  qrOrders      QrOrder[]

  @@index([role, status])
}

model SavedSpace {
  userId     String
  locationId String
  savedAt    DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  location ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vendor {
  id            String        @id @default(cuid())
  userId        String        @unique
  businessName  String
  gstNumber     String?
  panNumber     String?
  contactPhone  String
  address       String
  status        VendorStatus  @default(PENDING)
  // How this vendor account was created, and by which admin (null for self-registration).
  createdVia    VendorCreationSource @default(SELF_REGISTRATION)
  createdById   String?
  approvedAt    DateTime?
  approvedById  String?
  // Set when an admin rejects the vendor. rejectionNote stores the reason shown to them.
  rejectedAt    DateTime?
  rejectedById  String?
  rejectionNote String?       @db.Text
  // Set when an admin flips status to INACTIVE ("stopped working with us"). Cleared on reactivation.
  deactivatedAt   DateTime?
  deactivatedById String?
  payoutUpiId         String?
  aadharNumber        String?
  aadharDocUrl        String?
  // Aadhaar verification: a doc is "pending verification" once uploaded until an
  // admin approves it (sets verifiedAt). Admin direct-uploads are auto-verified.
  aadharVerifiedAt    DateTime?
  aadharVerifiedById  String?
  pendingProfileData  String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations ParkingLocation[]

  @@index([status])
}

// "List your space" prospect submissions from the customer landing page. Admins
// review these (with a pending tag) and approve/reject; no account is created here.
model VendorLead {
  id           String           @id @default(cuid())
  // "PARKING" = List-your-space request · "SERVICE" = auto-service partner request
  leadType        String        @default("PARKING")
  // For SERVICE leads: which service vertical they want to register (e.g. "Car wash")
  serviceCategory String?
  businessName String
  fullName     String
  email        String
  phone        String
  city         String
  slotsApprox  Int?
  notes        String?          @db.Text
  status       VendorLeadStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

model ParkingLocation {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  description String?  @db.Text
  addressLine String
  landmark    String?
  district    String?
  city        String
  state       String
  pincode     String
  area        String?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  isActive        Boolean             @default(false)
  approvalStatus  SpaceApprovalStatus @default(PENDING_REVIEW)
  approvalNote    String?             @db.Text
  approvedById    String?
  approvedAt      DateTime?
  pendingData     String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vendor      Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  slots       Slot[]
  images      LocationImage[]
  amenities   ParkingLocationAmenity[]
  savedByUsers SavedSpace[]

  @@index([city, isActive])
  @@index([latitude, longitude])
}

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String   @default("✓")
  description String?
  createdAt   DateTime @default(now())

  locations ParkingLocationAmenity[]
}

model ParkingLocationAmenity {
  locationId String
  amenityId  String

  location ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  amenity  Amenity         @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([locationId, amenityId])
}

model LocationImage {
  id         String   @id @default(cuid())
  locationId String
  url        String
  width      Int?
  height     Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  location ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Slot {
  id             String     @id @default(cuid())
  locationId     String
  code           String
  vehicleType    String     @default("CAR")
  hourlyPrice    Decimal    @db.Decimal(10, 2)
  dailyPrice     Decimal    @db.Decimal(10, 2)
  monthlyPrice   Decimal?   @db.Decimal(10, 2)
  status         SlotStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  location ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([locationId, code])
  @@index([status])
}

model Booking {
  id                 String        @id @default(cuid())
  reference          String        @unique
  userId             String?
  slotId             String
  startAt            DateTime
  endAt              DateTime
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  bookingType        BookingType   @default(HOURLY)
  status             BookingStatus @default(PENDING_PAYMENT)
  // Commission owed by the vendor to the company on this booking.
  // Rate + amount are snapshotted at creation so later rate changes don't rewrite history.
  commissionRate     Decimal          @default(10) @db.Decimal(5, 2)
  commissionAmount   Decimal          @default(0)  @db.Decimal(10, 2)
  commissionStatus   CommissionStatus @default(PENDING)
  commissionPaidAt   DateTime?
  cancelReason       String?       @db.Text
  isDirectBooking    Boolean       @default(false)
  guestName          String?
  // Email captured for a walk-in. The booking is claimed (userId set) when a
  // customer account with this email signs up / logs in. Not unique — many
  // bookings can share the same guest email.
  guestEmail         String?
  guestPhone         String?
  guestVehicleNumber String?
  guestVehicleModel  String?
  // Direct booking payment tracking
  paymentMethod      String?       // CASH | UPI | CARD_DEBIT | CARD_CREDIT | NETBANKING | WALLET
  refundAmount       Decimal?      @db.Decimal(10, 2)
  refundedAt         DateTime?
  refundNote         String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  slot     Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@index([slotId, startAt, endAt])
}

model Payment {
  id                 String        @id @default(cuid())
  bookingId          String
  provider           String        @default("razorpay")
  providerOrderId    String?
  providerPaymentId  String?
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(CREATED)
  rawResponse        String?       @db.Text
  // Refund tracking for online payments
  refundAmount       Decimal?      @db.Decimal(10, 2)
  refundedAt         DateTime?
  refundNote         String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
}

// Simple key/value store for admin-configurable settings (e.g. commission_rate).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── QR Calling ────────────────────────────────────────────────────────────────
// A single COMMON QR (one static URL on every sticker) routes a scanner to the
// "enter the plate" page; the full plate resolves to one of these registrations.
// The plate is looked up by a keyed hash (exact match) so the plaintext plate can
// stay encrypted. All phone numbers + the plate + medical notes are encrypted at
// the app layer before being written to the *_enc-style columns below.

enum RegistrationStatus {
  ACTIVE
  PAUSED
  TRANSFERRED
  DELETED
}

enum CallStatus {
  INITIATED
  RINGING_CALLER
  CALLER_ANSWERED
  RINGING_OWNER
  BRIDGED
  COMPLETED
  NO_ANSWER
  BUSY
  OWNER_REJECTED
  FAILED
  BLOCKED
  CANCELLED
}

enum LookupOutcome {
  FOUND
  NOT_FOUND
  RATE_LIMITED
  BOT_BLOCKED
}

enum BlockScope {
  REGISTRATION
  GLOBAL
}

model VehicleRegistration {
  id              String             @id @default(cuid())
  userId          String
  plateHash       String             @unique              // HMAC of normalized plate — exact-match lookup
  plateNumber     String             @db.Text             // encrypted; for display / confirmation
  contactPhone    String             @db.Text             // encrypted; the number bridged to
  contactVerified Boolean            @default(false)      // OTP-verified
  status          RegistrationStatus @default(ACTIVE)
  isActive        Boolean            @default(true)
  dailyReceiveCap Int                @default(15)
  silentFrom      String?                                 // "HH:mm" local
  silentTo        String?
  // ICE (In Case of Emergency) — every field opt-in, off by default
  emergencyPublic Boolean            @default(false)
  ownerName       String?
  bloodGroup      String?
  medicalNotes    String?            @db.Text             // encrypted
  deactivatedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]
  calls             CallSession[]
  qrOrders          QrOrder[]

  @@index([userId])
  @@index([status])
}

model EmergencyContact {
  id             String   @id @default(cuid())
  registrationId String
  name           String
  relation       String?
  phone          String   @db.Text                        // encrypted
  showPublic     Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  registration VehicleRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model CallSession {
  id              String     @id @default(cuid())
  registrationId  String
  provider        String                                  // 'mock' | 'exotel' | 'tata' | ...
  providerCallId  String?
  virtualNumber   String?
  callerPhone     String     @db.Text                     // encrypted
  callerPhoneHash String?                                 // HMAC — for per-caller rate limits / blocking
  callerIpHash    String?
  status          CallStatus @default(INITIATED)
  hangupCause     String?
  idempotencyKey  String?    @unique                      // double-tap / retry safe
  initiatedAt     DateTime   @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSec     Int?
  recordingUrl    String?    @db.Text
  costPaise       Int?
  rawPayload      String?    @db.Text                      // last provider payload (audit / debugging)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  registration VehicleRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([status])
  @@index([providerCallId])
  @@index([callerPhoneHash])
  @@index([createdAt])
}

model LookupAttempt {
  id        String        @id @default(cuid())
  plateHash String?
  ipHash    String
  outcome   LookupOutcome
  createdAt DateTime      @default(now())

  @@index([ipHash, createdAt])
}

model BlockedNumber {
  id             String     @id @default(cuid())
  phoneHash      String
  scope          BlockScope @default(REGISTRATION)
  registrationId String?
  reason         String?
  createdById    String?
  createdAt      DateTime   @default(now())

  @@index([phoneHash])
  @@index([registrationId])
}

model VirtualNumber {
  id        String   @id @default(cuid())
  e164      String   @unique
  provider  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum QrOrderStatus {
  PENDING    // submitted — awaiting admin follow-up to collect payment
  CONFIRMED  // admin confirmed payment received (offline — no gateway wired yet)
  SHIPPED
  DELIVERED
  CANCELLED
}

// A request for a physical QR sticker — collected while online payment is
// paused sitewide (see CheckoutPage.tsx), so this is "request only": no
// gateway charge happens here. Price fields are a snapshot of what the
// customer was shown at request time, so a later price change never rewrites
// history. Admin fulfills manually (confirm payment -> ship -> deliver).
model QrOrder {
  id                String        @id @default(cuid())
  userId            String
  registrationId    String?                                  // null if the linked car was later deleted
  stickerPricePaise Int                                       // one-time price shown at request time
  monthlyPricePaise Int                                       // call-service subscription price shown at request time
  status            QrOrderStatus @default(PENDING)
  shippingName      String
  shippingPhone     String
  addressLine       String        @db.Text
  city              String
  state             String
  pincode           String
  note              String?       @db.Text
  confirmedAt       DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration VehicleRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([registrationId])
}

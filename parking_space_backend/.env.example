# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.autosahay.com

# Comma-separated list of allowed frontend origins (no trailing slash)
# `test.autosahay.com` hosts the customer SPA during staging; switch to the
# final production URL (apex or `www`) once the existing site there is moved.
CORS_ORIGINS=https://admin.autosahay.com,https://vendor.autosahay.com,https://test.autosahay.com

# Absolute URLs for each frontend SPA (used for OAuth post-login redirects, no trailing slash)
FRONTEND_CUSTOMER_URL=https://test.autosahay.com
FRONTEND_VENDOR_URL=https://vendor.autosahay.com
FRONTEND_ADMIN_URL=https://admin.autosahay.com

# ── Database ───────────────────────────────────────────────────────────────────
# Runtime queries go through Prisma Accelerate (cloud engine + pooler) so no local
# query engine runs — this avoids the Hostinger "timer has gone away" crash.
#   DATABASE_URL : the Accelerate URL from console.prisma.io  (prisma://accelerate.prisma-data.net/?api_key=...)
#   DIRECT_URL   : the real MySQL connection, used ONLY by `prisma migrate`  (mysql://USER:PASS@HOST:3306/DB)
# Local dev can skip Accelerate: set DATABASE_URL to the mysql:// URL and omit DIRECT_URL.
DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY
DIRECT_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# ── JWT ────────────────────────────────────────────────────────────────────────
# Use a long random string — openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_minimum_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── QR Calling (scan-to-call) ────────────────────────────────────────────────
# AES-256-GCM key for plate/phone/medical-notes encryption + keyed lookup hashes.
# 64 hex chars (32 bytes) — openssl rand -hex 32. Rotating this makes existing
# encrypted rows undecryptable, so treat it like a JWT secret: set once, back up.
QR_DATA_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32

# Telephony adapter — 'mock' (default, no vendor account needed) or 'exotel'.
CALL_PROVIDER=mock

# ── Exotel (required only when CALL_PROVIDER=exotel) ────────────────────────
# Dashboard -> Settings -> API Settings for all four. Subdomain: api.in.exotel.com
# for Indian (Mumbai) accounts, api.exotel.com for Singapore-hosted accounts.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
# The ExoPhone(s) calls go out from — must already be purchased/provisioned in
# the Exotel dashboard; we never invent one at runtime. E.164 format
# (+91XXXXXXXXXX), not the local 0XXXXXXXXXX form. Comma-separated — with more
# than one, a call that fails to place on the first number automatically
# retries on the next.
EXOTEL_VIRTUAL_NUMBERS=
# Exotel's StatusCallback has no signature mechanism — this secret rides as a
# query param on the callback URL we hand Exotel, and is checked on receipt.
# openssl rand -hex 24
EXOTEL_WEBHOOK_SECRET=

# ── Cookies ────────────────────────────────────────────────────────────────────
# Set to your root domain so cookies work across subdomains
COOKIE_DOMAIN=autosahay.com
COOKIE_SECURE=true

# ── File Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ── Cloudflare R2 (object storage) ────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ── Super-admin bootstrap (used by `npm run prisma:seed`) ──────────────────────
# The seed creates ONE super admin if it doesn't already exist (idempotent).
# Always set a strong password before seeding production — do NOT ship the default.
SEED_SUPER_ADMIN_EMAIL=superadmin@autosahay.com
SEED_SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# ── Google OAuth (optional) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth (optional) ──────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Razorpay (required — no fallback gateway) ───────────────────────────────────
# All three required for any payment endpoint to work. Dashboard: Settings ->
# API Keys for the first two, Settings -> Webhooks (webhook URL:
# <API_BASE_URL>/api/webhooks/razorpay) for the secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMTP / Mail (optional) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
